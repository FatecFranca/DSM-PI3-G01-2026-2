spring.application.name=api

# Configura a porta da aplicação
server.port=8888

spring.mongodb.uri=

# Conexão do AmazonS3
aws.bucket-name=
aws.region=

aws.access-key=
aws.secret-key=

# Limite de tamanho dos arquivos enviados
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB